{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tourmaline",
  "version": "0.2.0",
  "identifier": "io.github.amcleani.tourmaline",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tourmaline",
        "width": 1280,
        "height": 860,
        "minWidth": 640,
        "minHeight": 400,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "amcleani",
    "shortDescription": "A PDF reader for academic research",
    "category": "Education",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tourmaline"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCNjk4QTY1RkY1QzkwREYKUldUZmtGei9aWXBwcTExb3hHZk1FTDBib2d6RTAxN3JDYWlZRUUzdUk0RzhUOXRjOVkwdW13a1kK",
      "endpoints": [
        "https://github.com/amcleani/tourmaline/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
